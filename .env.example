# PostgreSQL 16 connection string
DATABASE_URL=postgresql+psycopg://parlaypal:parlaypal@localhost:5432/parlaypal

# Redis 7.2 connection string
REDIS_URL=redis://localhost:6379/0

# External sportsbook & prop ingestion provider (services/worker only)
PARLAY_API_KEY=replace_with_parlay_api_key
PARLAY_API_BASE_URL=https://api.parlay-api.com/v1

# Player game-log provider (services/worker only). Leave empty to keep the generic fetcher.
# Set GAME_LOG_PROVIDER=moneyline to use MoneyLine (mlapi.bet). Turn auto-upgrade OFF in the dashboard.
GAME_LOG_PROVIDER=
MONEYLINE_API_KEY=replace_with_moneyline_api_key
MONEYLINE_API_BASE_URL=https://mlapi.bet/v1
# Requests per minute allowed by your MoneyLine plan: 10 on Free, 60 on Starter.
MONEYLINE_REQUESTS_PER_MINUTE=10
